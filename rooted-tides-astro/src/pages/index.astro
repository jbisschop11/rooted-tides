---
import BaseLayout from "../layouts/BaseLayout.astro";
import CalendlyPopupButton from "../components/CalendlyPopupButton.astro";

const CALENDLY = "https://calendly.com/jbisschop11/60-minute-reiki-session";
---

<BaseLayout
  title="Rooted Tides | Reiki in West Hants, Nova Scotia"
  description="High-touch, calming Reiki sessions in West Hants County, Nova Scotia. Book online with ease."
  canonical="/"
>
  <section class="hero">
    <div class="container heroWrap">
      <div>
        <div class="kicker">In-person Reiki • West Hants County, Nova Scotia</div>

        <h1 style="margin-top:10px; margin-bottom:14px;">Rooted Tides</h1>

        <p class="small" style="font-size:1.07rem; max-width:44rem; margin-bottom:18px;">
          High-touch calm for modern life. Gentle Reiki sessions designed to help you downshift, soften,
          and feel deeply grounded—like a quiet reset for your whole system.
        </p>

        <div style="display:flex; gap:14px; flex-wrap:wrap; align-items:center; margin-top:6px;">
          <CalendlyPopupButton calendlyUrl={CALENDLY} label="Book a Session" />
          <a
            href="/book"
            class="small"
            style="text-decoration:underline; text-underline-offset:4px;"
          >
            View the calendar
          </a>
          <a
            href="/services"
            class="small"
            style="text-decoration:underline; text-underline-offset:4px;"
          >
            View packages
          </a>
        </div>

        <div style="margin-top:18px; display:flex; gap:10px; flex-wrap:wrap;">
          <span class="badge">60 minutes</span>
          <span class="badge">Packages (10% off)</span>
        </div>

        <p class="small" style="margin-top:14px; max-width:44rem;">
          Exact location details are shared after booking in your confirmation email.
          Reiki is a complementary wellness practice and not a substitute for medical care.
        </p>
      </div>

      <div>
        <img
          class="heroImg"
          src="/images/sarah-harbor.jpg"
          alt="Sarah outdoors by the Nova Scotia waterfront with her dog."
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        <div class="card" style="padding:30px;">
          <h2>What is Reiki?</h2>
          <p class="small">
            Reiki is a gentle, hands-on (or hands-near) energy healing practice that invites deep relaxation.
            Sessions are quiet, grounding, and tailored to what you need that day.
          </p>
        </div>

        <div class="card" style="padding:30px;">
          <h2>Why people book</h2>
          <ul class="small" style="margin:0; padding-left:18px;">
            <li>Stress relief and deep rest</li>
            <li>Feeling grounded and present</li>
            <li>Support through busy or emotional seasons</li>
            <li>A gentle reset for body and mind</li>
          </ul>
          <p class="small" style="margin-top:12px;">
            Many clients leave feeling softer, steadier, and more clear.
          </p>
        </div>

        <div class="card" style="padding:30px;">
          <h2>Simple online booking</h2>
          <p class="small">
            Choose a time that works for you. You’ll receive a confirmation email with
            exact location details, directions, and preparation notes.
          </p>
          <div style="margin-top:14px;">
            <CalendlyPopupButton calendlyUrl={CALENDLY} label="Book Now" />
          </div>
        </div>
      </div>

      <div class="grid grid-2" style="margin-top:28px;">
        <div class="card" style="padding:34px;">
          <h2>Meet Sarah</h2>
          <p class="small" style="max-width:46rem;">
            Rooted Tides is guided by an earthy, grounded approach to healing and rest.
            Sarah practices within the traditional <strong>Usui Shiki Ryoho</strong> healing system,
            stemming from the lineage of <strong>Reiki Master Mikao Usui</strong>.
          </p>
          <div style="margin-top:16px; display:flex; gap:12px; flex-wrap:wrap; align-items:center;">
            <a class="btn" href="/about">Read Sarah’s story</a>
            <a
              href="/expect"
              class="small"
              style="text-decoration:underline; text-underline-offset:4px;"
            >
              What to expect
            </a>
          </div>
        </div>

        <div class="card" style="padding:0; overflow:hidden;">
          <img
            src="/images/sarah-garden.jpg"
            alt="Sarah smiling outdoors under green leaves."
            style="width:100%; height:420px; object-fit:cover; display:block;"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="card" style="padding:36px;">
        <h2 style="margin-bottom:8px;">Ready to book?</h2>
        <p class="small" style="max-width:50rem;">
          Choose a time that works for you. Booking takes under a minute—and you’ll get everything you need
          (including location details) in your confirmation email.
        </p>
        <div style="display:flex; gap:14px; flex-wrap:wrap; align-items:center; margin-top:16px;">
          <CalendlyPopupButton calendlyUrl={CALENDLY} label="Book a Reiki Session" />
          <a class="btn" href="/contact">Questions? Contact</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
